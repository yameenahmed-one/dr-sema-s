<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} | {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | escape }}">

  {{ content_for_header }}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Theme CSS -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'responsive.css' | asset_url | stylesheet_tag }}
  {{ 'loader.css' | asset_url | stylesheet_tag }}
</head>
<body>

  <!-- LUXURY LOADER -->
  <div id="luxury-loader">
    <div class="ldr-bg"></div>
    <div class="ldr-leaves">
      <div class="ldr-leaf ldr-leaf-1"></div>
      <div class="ldr-leaf ldr-leaf-2"></div>
      <div class="ldr-leaf ldr-leaf-3"></div>
      <div class="ldr-leaf ldr-leaf-4"></div>
      <div class="ldr-leaf ldr-leaf-5"></div>
      <div class="ldr-leaf ldr-leaf-6"></div>
    </div>
    <div class="ldr-center">
      <div class="ldr-ring ldr-ring-outer"></div>
      <div class="ldr-ring ldr-ring-inner"></div>
      <div class="ldr-seal"><span class="ldr-ds">KCC</span></div>
    </div>
    <div class="ldr-text">
      <h1 class="ldr-brand">{{ shop.name }}</h1>
      <p class="ldr-sub">Clinical Botanical Science</p>
      <div class="ldr-dots">
        <span class="ldr-dot"></span>
        <span class="ldr-dot"></span>
        <span class="ldr-dot"></span>
      </div>
    </div>
  </div>

  <div id="app-content" style="opacity:0;transition:opacity 0.8s ease;">

    <!-- HEADER -->
    {% section 'header' %}

    <!-- PAGE CONTENT -->
    <main>
      {{ content_for_layout }}
    </main>

    <!-- FOOTER -->
    {% section 'site-footer' %}

    <!-- DRAWERS -->
    {% section 'cart-drawer' %}
    {% section 'search-overlay' %}
    {% section 'mobile-nav' %}

  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Theme JS -->
  {{ 'theme.js' | asset_url | script_tag }}
  {{ 'chatbot.js' | asset_url | script_tag }}

  <script>
    // Failsafe: if loader JS fails, show content after 2.5s
    setTimeout(function() {
      var appContent = document.getElementById('app-content');
      var loader = document.getElementById('luxury-loader');
      if (appContent) appContent.style.opacity = '1';
      if (loader) loader.style.opacity = '0';
      setTimeout(function() { if (loader) loader.style.display = 'none'; }, 400);
    }, 2500);
  </script>

</body>
</html>

