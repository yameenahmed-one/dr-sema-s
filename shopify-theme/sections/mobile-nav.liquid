<div id="mobile-drawer" class="mobile-offcanvas-menu">
  <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
    <a href="{{ routes.root_url }}" class="brand-logo">
      <div class="logo-icon-seal">DS</div>
      <div>
        <span class="logo-text-title">{{ shop.name }}</span>
        <span class="logo-text-tag">Clinical Skincare</span>
      </div>
    </a>
    <button class="btn-close" onclick="document.getElementById('mobile-drawer').classList.remove('active')"></button>
  </div>

  <div class="mb-4">
    <form action="{{ routes.search_url }}" method="get">
      <input type="hidden" name="type" value="product">
      <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" name="q" class="form-control bg-light border-start-0" placeholder="Search formulations...">
      </div>
    </form>
  </div>

  <ul class="mobile-nav-list list-unstyled mb-4">
    <li><a href="{{ routes.root_url }}" onclick="document.getElementById('mobile-drawer').classList.remove('active')"><i class="bi bi-house me-2 text-sage"></i> Home</a></li>
    <li><a href="{{ routes.collections_url }}" onclick="document.getElementById('mobile-drawer').classList.remove('active')"><i class="bi bi-bag me-2 text-sage"></i> Shop</a></li>
    <li><a href="/collections/all" onclick="document.getElementById('mobile-drawer').classList.remove('active')"><i class="bi bi-grid me-2 text-sage"></i> Collections</a></li>
    <li><a href="/pages/skin-concerns" onclick="document.getElementById('mobile-drawer').classList.remove('active')"><i class="bi bi-heart-pulse me-2 text-sage"></i> Skin Concerns</a></li>
    <li><a href="/pages/about" onclick="document.getElementById('mobile-drawer').classList.remove('active')"><i class="bi bi-person-badge me-2 text-sage"></i> About Dr. Seema</a></li>
    <li><a href="{{ routes.cart_url }}" onclick="document.getElementById('mobile-drawer').classList.remove('active')"><i class="bi bi-bag-check me-2 text-sage"></i> Cart ({{ cart.item_count }})</a></li>
    <li><a href="#footer" onclick="document.getElementById('mobile-drawer').classList.remove('active')"><i class="bi bi-envelope me-2 text-sage"></i> Contact</a></li>
  </ul>

  <div class="mt-auto pt-3 border-top d-flex flex-column gap-2">
    {% if customer %}
      <a href="{{ routes.account_url }}" class="btn btn-outline-dark rounded-pill w-100 d-flex align-items-center justify-content-between px-3 py-2">
        <span><i class="bi bi-person me-2"></i> My Account</span>
        <i class="bi bi-chevron-right"></i>
      </a>
    {% else %}
      <a href="{{ routes.account_login_url }}" class="btn btn-outline-dark rounded-pill w-100 d-flex align-items-center justify-content-between px-3 py-2">
        <span><i class="bi bi-person me-2"></i> Login / Register</span>
        <i class="bi bi-chevron-right"></i>
      </a>
    {% endif %}
    <a href="{{ routes.checkout_url }}" class="btn-hero-primary w-100 mt-2 d-flex align-items-center justify-content-center gap-2">
      <i class="bi bi-lock-fill"></i> Secure Checkout
    </a>
  </div>
</div>

{% schema %}
{ "name": "Mobile Nav", "settings": [] }
{% endschema %}
