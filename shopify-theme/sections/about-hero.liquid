<section style="min-height:92vh;background:linear-gradient(135deg,rgba(15,26,25,0.93) 0%,rgba(21,34,33,0.88) 60%,rgba(33,79,75,0.82) 100%),url('{{ section.settings.hero_image | img_url: "master" }}') center/cover no-repeat fixed;display:flex;align-items:center;padding-top:110px;overflow:hidden;">
  <div class="container relative-z2">
    <div class="row align-items-center g-5">
      <div class="col-lg-7 reveal-fade-left">
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(200,230,213,0.15);border:1px solid rgba(200,230,213,0.3);color:var(--accent-mint);padding:6px 18px;border-radius:999px;font-size:0.72rem;font-weight:700;letter-spacing:0.16em;margin-bottom:20px;">
          <i class="bi bi-patch-check-fill"></i> {{ section.settings.tag }}
        </div>
        <h1 style="font-family:var(--font-heading);font-size:clamp(3rem,6vw,5.5rem);color:#fff;line-height:1.05;font-weight:500;margin-bottom:6px;">
          {{ section.settings.heading }}<br><em style="font-style:italic;color:var(--accent-mint);">{{ section.settings.heading_italic }}</em>
        </h1>
        <p style="font-family:var(--font-heading);font-size:clamp(1.1rem,2vw,1.5rem);color:rgba(200,230,213,0.85);font-style:italic;margin-bottom:20px;">{{ section.settings.subtitle }}</p>
        <p style="font-size:1rem;color:rgba(255,255,255,0.75);max-width:560px;line-height:1.7;margin-bottom:36px;">{{ section.settings.description }}</p>
        <div class="d-flex flex-wrap gap-3">
          <a href="#about-story" class="btn-hero-primary">{{ section.settings.btn1_text }} <i class="bi bi-arrow-down ms-1"></i></a>
          <a href="{{ routes.collections_url }}" class="btn-hero-outline"><i class="bi bi-bag me-1"></i> {{ section.settings.btn2_text }}</a>
        </div>
        <div class="d-flex flex-wrap gap-4 mt-5">
          {% for block in section.blocks %}
            <div class="text-center">
              <div style="font-family:var(--font-heading);font-size:2.4rem;font-weight:700;color:#fff;line-height:1;">{{ block.settings.number }}<span style="color:var(--accent-mint);">{{ block.settings.suffix }}</span></div>
              <div style="font-size:0.75rem;color:rgba(255,255,255,0.6);letter-spacing:0.08em;margin-top:4px;">{{ block.settings.label }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="col-lg-5 reveal-fade-right">
        {% if section.settings.doctor_image %}
          <div style="position:relative;border-radius:var(--radius-lg);overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.12);">
            <img src="{{ section.settings.doctor_image | img_url: 'master' }}" alt="{{ section.settings.heading_italic }}" style="width:100%;height:580px;object-fit:cover;display:block;">
            <div style="position:absolute;bottom:24px;left:24px;right:24px;background:rgba(15,26,25,0.88);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.12);border-radius:var(--radius-md);padding:16px 20px;display:flex;align-items:center;gap:14px;">
              <div style="width:44px;height:44px;border-radius:50%;background:var(--primary-sage);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;"><i class="bi bi-award-fill"></i></div>
              <div>
                <div style="font-size:0.85rem;font-weight:700;color:#fff;">{{ section.settings.badge_title }}</div>
                <div style="font-size:0.72rem;color:rgba(255,255,255,0.6);">{{ section.settings.badge_sub }}</div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Background Image" },
    { "type": "image_picker", "id": "doctor_image", "label": "Doctor Portrait Image" },
    { "type": "text", "id": "tag", "label": "Tag Pill Text", "default": "BOARD-CERTIFIED DERMATOLOGIST" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet" },
    { "type": "text", "id": "heading_italic", "label": "Heading Italic Part", "default": "Dr. Sema" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Founder · Clinical Dermatologist · Skincare Visionary" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "With over 18 years of clinical dermatology practice, Dr. Sema bridges the gap between pharmaceutical precision and nature's purest actives." },
    { "type": "text", "id": "btn1_text", "label": "Button 1 Text", "default": "Her Story" },
    { "type": "text", "id": "btn2_text", "label": "Button 2 Text", "default": "Shop Formulations" },
    { "type": "text", "id": "badge_title", "label": "Badge Title", "default": "Pakistan's #1 Clinical Dermatologist" },
    { "type": "text", "id": "badge_sub", "label": "Badge Subtitle", "default": "Board Certified · 18+ Years Experience" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "18" },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Years Practice" }
      ]
    }
  ],
  "presets": [{ "name": "About Hero", "blocks": [
    { "type": "stat", "settings": { "number": "18", "suffix": "+", "label": "Years Practice" } },
    { "type": "stat", "settings": { "number": "50", "suffix": "K+", "label": "Patients Treated" } },
    { "type": "stat", "settings": { "number": "48", "suffix": "+", "label": "Formulations" } },
    { "type": "stat", "settings": { "number": "12", "suffix": "+", "label": "Global Awards" } }
  ]}]
}
{% endschema %}

