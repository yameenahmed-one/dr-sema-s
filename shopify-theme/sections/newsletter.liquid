<section class="newsletter-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    {% unless section.settings.enable_section %}display:none;{% endunless %}
  ">
  <div class="container">
    <div class="newsletter-card-wrapper reveal-scale">
      {% if section.settings.tagline != blank %}
        <span class="section-tagline" style="color: {{ section.settings.text_color }};">{{ section.settings.tagline }}</span>
      {% endif %}
      <h2 class="section-main-title" style="color: {{ section.settings.text_color }};">{{ section.settings.heading }}</h2>
      {% if section.settings.description != blank %}
        <p class="section-description mb-4" style="max-width:540px;margin:0 auto;color: {{ section.settings.text_color }};">{{ section.settings.description }}</p>
      {% endif %}
      {% form 'customer', id: 'newsletter-form' %}
        {{ form.errors | default_errors }}
        {% if form.posted_successfully? %}
          <p class="text-success fw-bold">{{ section.settings.success_message }}</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-input-group">
            <input
              type="email"
              name="contact[email]"
              class="newsletter-input"
              placeholder="{{ section.settings.placeholder }}"
              required
              aria-label="{{ section.settings.placeholder }}">
            <button
              type="submit"
              class="btn-hero-primary px-4"
              style="background-color: {{ section.settings.button_color }};border-color: {{ section.settings.button_color }};"
              onmouseover="this.style.backgroundColor='{{ section.settings.button_hover_color }}';this.style.borderColor='{{ section.settings.button_hover_color }}';"
              onmouseout="this.style.backgroundColor='{{ section.settings.button_color }}';this.style.borderColor='{{ section.settings.button_color }}';">
              {{ section.settings.button_text }}
            </button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Club Seema Inner Circle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Receive 15% Off Your First Order"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join our VIP circle for dermatologist skincare guides and early access to new releases."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder text",
      "default": "Enter your email address..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe & Claim 15%"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing! Check your inbox for your 15% discount code."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#152221"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#2F6B66"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#C8E6D5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}

