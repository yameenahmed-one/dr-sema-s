<section id="clinical-results" class="before-after-section"
  style="background-color:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">

      <!-- Text Column -->
      <div class="col-lg-5 reveal-fade-left">
        <span class="section-tagline" style="color:{{ section.settings.accent_color }};">{{ section.settings.tagline }}</span>
        <h2 class="section-main-title mb-3" style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
        <p class="section-description mb-4" style="color:{{ section.settings.text_color }};">{{ section.settings.description }}</p>

        <div class="ba-metrics-list mb-4">
          {% for block in section.blocks %}
            <div class="ba-metric-item" {{ block.shopify_attributes }}>
              <span class="ba-metric-num" style="color:{{ section.settings.accent_color }};">{{ block.settings.percentage }}</span>
              <span class="ba-metric-text" style="color:{{ section.settings.text_color }};">{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.btn_text != blank %}
          <a href="{{ section.settings.btn_url }}" class="btn-hero-primary"
            style="background-color:{{ section.settings.btn_color }};border-color:{{ section.settings.btn_color }};">
            {{ section.settings.btn_text }} <i class="bi bi-arrow-right ms-2"></i>
          </a>
        {% endif %}
      </div>

      <!-- Before/After Image Column -->
      <div class="col-lg-7 reveal-fade-right">
        <div class="before-after-wrapper">
          {% if section.settings.after_image != blank %}
            <img src="{{ section.settings.after_image | img_url: 'master' }}" class="ba-image" alt="{{ section.settings.after_label }}">
          {% endif %}
          <div class="ba-before-container">
            {% if section.settings.before_image != blank %}
              <img src="{{ section.settings.before_image | img_url: 'master' }}" class="ba-before-img" alt="{{ section.settings.before_label }}">
            {% endif %}
          </div>
          <span class="ba-label ba-label-before">{{ section.settings.before_label }}</span>
          <span class="ba-label ba-label-after"><i class="bi bi-check-circle-fill text-mint me-1"></i> {{ section.settings.after_label }}</span>
          <div class="ba-handle"><div class="ba-handle-circle"><i class="bi bi-arrows-collapse"></i></div></div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before / After",
  "tag": "section",
  "class": "section-before-after",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "CLINICALLY PROVEN RESULTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visible Skin Transformation In 4 Weeks"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "In independent 28-day double-blind clinical trials, Dr. Seema's Cellular Renewal Ritual demonstrated dramatic skin barrier repair."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Shop Trial Ritual"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "BEFORE"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "AFTER 4 WEEKS"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f4f9f7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#152221"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#2F6B66"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button color",
      "default": "#2F6B66"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Result Metric",
      "settings": [
        {
          "type": "text",
          "id": "percentage",
          "label": "Percentage / number",
          "default": "98%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Metric label",
          "default": "Noticed visible reduction in hyperpigmentation and dark spots"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before / After",
      "blocks": [
        { "type": "metric", "settings": { "percentage": "98%", "label": "Noticed visible reduction in hyperpigmentation and dark spots" } },
        { "type": "metric", "settings": { "percentage": "96%", "label": "Reported enhanced skin firmness and collagen bounce" } },
        { "type": "metric", "settings": { "percentage": "100%", "label": "Experienced deep 72-hour moisture barrier hydration" } }
      ]
    }
  ]
}
{% endschema %}
