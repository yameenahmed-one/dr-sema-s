<section style="background-color:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="container">

    <div class="text-center mb-5">
      {% if section.settings.tagline != blank %}
        <span class="section-tagline" style="color:{{ section.settings.accent_color }};">{{ section.settings.tagline }}</span>
      {% endif %}
      <h1 class="font-serif" style="font-size:clamp(2rem,4vw,3rem);color:{{ section.settings.heading_color }};">
        {{ blog.title }}
      </h1>
      {% if section.settings.show_tags and blog.all_tags.size > 0 %}
        <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
          <a href="{{ blog.url }}" class="badge bg-white text-dark py-2 px-3">{{ section.settings.all_tag_label }}</a>
          {% for tag in blog.all_tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}"
              class="badge bg-light text-dark py-2 px-3">{{ tag }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% paginate blog.articles by section.settings.articles_per_page %}
      <div class="row g-{{ section.settings.grid_gap }}">
        {% for article in blog.articles %}
          <div class="col-lg-{{ 12 | divided_by: section.settings.columns }} col-md-6">
            <div class="bg-white rounded-4 shadow-sm overflow-hidden h-100">
              {% if section.settings.show_images and article.image %}
                <a href="{{ article.url }}">
                  <img src="{{ article.image | img_url: '600x' }}" alt="{{ article.title | escape }}"
                    class="w-100" style="height:{{ section.settings.image_height }}px;object-fit:cover;">
                </a>
              {% endif %}
              <div class="p-4">
                {% if section.settings.show_tags %}
                  <span class="badge bg-light text-dark py-1 px-2 mb-2" style="font-size:.7rem;color:{{ section.settings.accent_color }};">
                    {{ article.tags | first }}
                  </span>
                {% endif %}
        <h3 class="font-serif mb-2" style="font-size:{{ section.settings.card_title_size }}px;color:{{ section.settings.heading_color }};">
                  <a href="{{ article.url }}" style="color:{{ section.settings.heading_color }};text-decoration:none;">{{ article.title }}</a>
                </h3>
                {% if section.settings.show_excerpt %}
                  <p class="mb-3" style="color:{{ section.settings.text_color }};font-size:.9rem;line-height:1.6;">
                    {{ article.excerpt_or_content | strip_html | truncate: section.settings.excerpt_length }}
                  </p>
                {% endif %}
                <div class="d-flex align-items-center justify-content-between" style="font-size:.8rem;color:{{ section.settings.text_color }};">
                  {% if section.settings.show_date %}
                    <span><i class="bi bi-calendar3 me-1"></i> {{ article.published_at | date: section.settings.date_format }}</span>
                  {% endif %}
                  <a href="{{ article.url }}" style="color:{{ section.settings.accent_color }};font-weight:600;text-decoration:none;">
                    {{ section.settings.read_more_text }} <i class="bi bi-arrow-right"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="d-flex justify-content-center gap-2 mt-5">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</section>

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline above title",
      "default": "SKINCARE INSIGHTS"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 18,
      "step": 3,
      "default": 9
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Card gap",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Card Options"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show article images",
      "default": true
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Card image height",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tag chips",
      "default": true
    },
    {
      "type": "text",
      "id": "all_tag_label",
      "label": "\"All\" tag label",
      "default": "All"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_length",
      "label": "Excerpt length (characters)",
      "min": 60,
      "max": 300,
      "step": 20,
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "Date format",
      "default": "%b %d, %Y"
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Read More"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18,
      "info": "In pixels"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f4f9f7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#152221"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#2F6B66"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 60, "max": 160, "step": 4, "unit": "px", "default": 130
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    }
  ],
  "presets": [
    {
      "name": "Main Blog"
    }
  ]
}
{% endschema %}
