<section style="min-height:70vh;display:flex;align-items:center;justify-content:center;background:var(--bg-light-mint);padding-top:120px;">
  <div class="container text-center px-4">
    <div style="font-family:var(--font-heading);font-size:clamp(6rem,15vw,12rem);font-weight:700;color:var(--primary-sage);line-height:1;margin-bottom:16px;opacity:0.15;">404</div>
    <div style="margin-top:-60px;position:relative;z-index:2;">
      <div style="width:80px;height:80px;border-radius:50%;background:rgba(47,107,102,0.1);color:var(--primary-sage);font-size:2.2rem;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
        <i class="bi bi-search"></i>
      </div>
      <h1 style="font-family:var(--font-heading);font-size:clamp(1.8rem,3vw,2.8rem);color:var(--text-dark);margin-bottom:14px;">Page Not Found</h1>
      <p style="color:var(--text-muted);font-size:1rem;max-width:480px;margin:0 auto 32px;line-height:1.7;">The page you are looking for does not exist or has been moved. Let us help you find what you need.</p>
      <div class="d-flex flex-wrap gap-3 justify-content-center mb-5">
        <a href="{{ routes.root_url }}" class="btn-hero-primary px-5 py-3">Return Home <i class="bi bi-house ms-2"></i></a>
        <a href="{{ routes.collections_url }}" class="btn-hero-outline px-5 py-3">Shop All Products</a>
      </div>
      <div>
        <p style="font-size:0.82rem;font-weight:700;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:16px;">POPULAR PAGES</p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
          <a href="{{ routes.collections_url }}" style="background:#fff;border:1px solid var(--border-light);color:var(--text-dark);padding:8px 20px;border-radius:999px;font-size:0.85rem;font-weight:600;text-decoration:none;">Shop All</a>
          <a href="/pages/about" style="background:#fff;border:1px solid var(--border-light);color:var(--text-dark);padding:8px 20px;border-radius:999px;font-size:0.85rem;font-weight:600;text-decoration:none;">About Dr. Sema</a>
          <a href="{{ routes.cart_url }}" style="background:#fff;border:1px solid var(--border-light);color:var(--text-dark);padding:8px 20px;border-radius:999px;font-size:0.85rem;font-weight:600;text-decoration:none;">Cart</a>
          <a href="/pages/skin-concerns" style="background:#fff;border:1px solid var(--border-light);color:var(--text-dark);padding:8px 20px;border-radius:999px;font-size:0.85rem;font-weight:600;text-decoration:none;">Skin Concerns</a>
          <a href="#footer" style="background:#fff;border:1px solid var(--border-light);color:var(--text-dark);padding:8px 20px;border-radius:999px;font-size:0.85rem;font-weight:600;text-decoration:none;">Contact</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "404 Page", "settings": [] }
{% endschema %}

