<section style="background:var(--bg-light-mint);padding:90px 0;">
  <div class="container px-3 px-md-5">
    <div class="section-header-center reveal-on-scroll mb-5">
      <span class="section-tagline">{{ section.settings.tagline }}</span>
      <h2 class="section-main-title">{{ section.settings.heading }}</h2>
      <p class="section-description">{{ section.settings.description }}</p>
    </div>
    <div class="row g-4">
      {% for block in section.blocks %}
        <div class="col-lg-3 col-md-6 reveal-on-scroll">
          <div style="background:#fff;border:1px solid var(--border-light);border-radius:var(--radius-md);padding:28px 24px;height:100%;box-shadow:var(--shadow-soft);text-align:center;transition:all 0.35s;">
            <div style="width:64px;height:64px;border-radius:50%;background:var(--bg-light-mint);color:var(--primary-sage);display:flex;align-items:center;justify-content:center;font-size:1.7rem;margin:0 auto 18px;box-shadow:0 4px 14px rgba(47,107,102,0.1);">
              <i class="{{ block.settings.icon }}"></i>
            </div>
            <div style="font-family:var(--font-heading);font-size:1.15rem;font-weight:600;color:var(--text-dark);margin-bottom:6px;">{{ block.settings.name }}</div>
            <p style="font-size:0.82rem;color:var(--text-muted);line-height:1.55;margin-bottom:12px;">{{ block.settings.text }}</p>
            <span style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;color:var(--primary-sage);">{{ block.settings.year }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Certifications",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "CREDENTIALS & RESEARCH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clinical Certifications" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Internationally recognised qualifications underpinning every Dr. Seema formulation." }
  ],
  "blocks": [{
    "type": "cert", "name": "Certification",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon Class", "default": "bi bi-mortarboard-fill" },
      { "type": "text", "id": "name", "label": "Name", "default": "FCPS Dermatology" },
      { "type": "textarea", "id": "text", "label": "Description", "default": "Fellowship of the College of Physicians & Surgeons Pakistan." },
      { "type": "text", "id": "year", "label": "Year", "default": "AWARDED 2005" }
    ]
  }],
  "presets": [{ "name": "Certifications", "blocks": [
    { "type": "cert", "settings": { "icon": "bi bi-mortarboard-fill", "name": "FCPS Dermatology", "text": "Fellowship of the College of Physicians & Surgeons Pakistan — highest post-graduate dermatology qualification.", "year": "AWARDED 2005" }},
    { "type": "cert", "settings": { "icon": "bi bi-globe2", "name": "Fellowship London", "text": "Advanced aesthetic dermatology fellowship at King's College Hospital, London.", "year": "AWARDED 2010" }},
    { "type": "cert", "settings": { "icon": "bi bi-journal-medical", "name": "Research Publications", "text": "14 peer-reviewed publications in international dermatology journals.", "year": "2008 — PRESENT" }},
    { "type": "cert", "settings": { "icon": "bi bi-patch-check-fill", "name": "PMDC Registration", "text": "Pakistan Medical & Dental Council registered specialist. Active PAD member.", "year": "ACTIVE MEMBER" }},
    { "type": "cert", "settings": { "icon": "bi bi-award-fill", "name": "ISO 22716 GMP", "text": "All formulations manufactured under ISO 22716 GMP certified facilities.", "year": "CERTIFIED FACILITY" }},
    { "type": "cert", "settings": { "icon": "bi bi-building", "name": "AAD Membership", "text": "International member of the American Academy of Dermatology.", "year": "MEMBER SINCE 2012" }}
  ]}]
}
{% endschema %}
