<section id="about-story" style="background:#fff;padding:90px 0;">
  <div class="container px-3 px-md-5">
    <div class="row align-items-start g-5">
      <div class="col-lg-5 reveal-fade-left">
        {% if section.settings.image %}
          <div style="position:relative;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-hover);border:1px solid var(--border-light);">
            <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.heading }}" style="width:100%;height:520px;object-fit:cover;display:block;">
            <div style="position:absolute;bottom:22px;left:22px;right:22px;background:rgba(255,255,255,0.94);backdrop-filter:blur(12px);border-radius:var(--radius-md);padding:14px 18px;border:1px solid rgba(255,255,255,0.9);box-shadow:0 8px 24px rgba(0,0,0,0.08);display:flex;align-items:center;gap:12px;">
              <div style="width:42px;height:42px;border-radius:50%;background:var(--bg-light-mint);color:var(--primary-sage);font-size:1.2rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="bi bi-shield-check"></i></div>
              <div>
                <div style="font-size:0.82rem;font-weight:700;color:var(--dark-forest);">{{ section.settings.badge_text }}</div>
                <div style="font-size:0.75rem;color:var(--text-muted);">{{ section.settings.badge_sub }}</div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
      <div class="col-lg-7 reveal-fade-right">
        <span class="section-tagline">{{ section.settings.tagline }}</span>
        <h2 class="section-main-title mb-3">{{ section.settings.heading }}</h2>
        <p style="font-size:1rem;color:var(--text-muted);line-height:1.75;margin-bottom:28px;">{{ section.settings.description }}</p>
        <div style="position:relative;padding-left:32px;">
          <div style="position:absolute;left:10px;top:8px;bottom:8px;width:2px;background:linear-gradient(180deg,var(--primary-sage),var(--accent-mint));border-radius:2px;"></div>
          {% for block in section.blocks %}
            <div style="position:relative;margin-bottom:32px;">
              <div style="position:absolute;left:-28px;top:4px;width:18px;height:18px;border-radius:50%;background:var(--primary-sage);border:3px solid #fff;box-shadow:0 0 0 3px rgba(47,107,102,0.25);z-index:1;"></div>
              <div style="font-size:0.72rem;font-weight:700;letter-spacing:0.12em;color:var(--primary-sage);margin-bottom:4px;">{{ block.settings.year }}</div>
              <h4 style="font-family:var(--font-heading);font-size:1.25rem;font-weight:600;color:var(--text-dark);margin-bottom:6px;">{{ block.settings.title }}</h4>
              <p style="font-size:0.88rem;color:var(--text-muted);line-height:1.6;margin:0;">{{ block.settings.text }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder Story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder Image" },
    { "type": "text", "id": "tagline", "label": "Section Tagline", "default": "FOUNDER'S JOURNEY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From Clinic to Botanical Lab" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Dr. Seema's journey began in the consultation room — listening to thousands of patients frustrated by ineffective products." },
    { "type": "text", "id": "badge_text", "label": "Image Badge Text", "default": "Board-Certified Dermatologist" },
    { "type": "text", "id": "badge_sub", "label": "Image Badge Subtitle", "default": "PMDC · FCPS · Fellowship London" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Timeline Milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2005" },
        { "type": "text", "id": "title", "label": "Title", "default": "FCPS Dermatology — Lahore" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Completed Fellowship in Dermatology with distinction." }
      ]
    }
  ],
  "presets": [{ "name": "Founder Story", "blocks": [
    { "type": "milestone", "settings": { "year": "2005", "title": "FCPS Dermatology — Lahore", "text": "Completed Fellowship in Dermatology with distinction. Began clinical practice treating thousands of patients." } },
    { "type": "milestone", "settings": { "year": "2010", "title": "Fellowship — King's College London", "text": "Advanced training in cosmetic dermatology. Pioneered botanical-clinical treatments for hyperpigmentation." } },
    { "type": "milestone", "settings": { "year": "2019", "title": "Launch of Dr. Seema's Products", "text": "Officially launched clinical skincare brand. Sold out within 72 hours. Nationwide distribution within 6 months." } },
    { "type": "milestone", "settings": { "year": "2024", "title": "48 Formulations · 50,000+ Clients", "text": "Recognised as Pakistan's leading clinical skincare brand. 12 international beauty awards." } }
  ]}]
}
{% endschema %}
