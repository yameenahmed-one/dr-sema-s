<section style="background-color:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="section-header-center reveal-on-scroll mb-5">
      {% if section.settings.tagline != blank %}
        <span class="section-tagline" style="color:{{ section.settings.accent_color }};">{{ section.settings.tagline }}</span>
      {% endif %}
      <h2 class="section-main-title" style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
    </div>
    <div class="row g-4">
      {% assign related_col = product.collections.first %}
      {% if related_col %}
        {% assign shown = 0 %}
        {% for p in related_col.products limit: 8 %}
          {% unless p.id == product.id or shown >= section.settings.products_count %}
            <div class="col-lg-3 col-md-6 reveal-on-scroll">
              {% render 'product-card', product: p %}
            </div>
            {% assign shown = shown | plus: 1 %}
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "COMPLETE YOUR RITUAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f4f9f7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#152221"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#2F6B66"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
