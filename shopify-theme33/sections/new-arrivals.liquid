<section id="new-arrivals" class="new-arrivals-section"
  style="background-color:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="container-fluid px-3 px-md-5 mb-4">
    <div class="section-header-center reveal-on-scroll">
      {% if section.settings.tagline != blank %}
        <span class="section-tagline" style="color:{{ section.settings.accent_color }};">{{ section.settings.tagline }}</span>
      {% endif %}
      <h2 class="section-main-title" style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      {% if section.settings.description != blank %}
        <p class="section-description" style="color:{{ section.settings.text_color }};">{{ section.settings.description }}</p>
      {% endif %}
    </div>
  </div>

  <div class="product-marquee-viewport">
    <div class="product-marquee-track">
      {% assign new_col = collections[section.settings.collection] %}
      {% assign products_to_show = new_col.products | default: collections.all.products %}
      {% assign marquee_count = section.settings.products_count %}
      {% for product in products_to_show limit: marquee_count %}
        {% render 'product-card', product: product %}
      {% endfor %}
      {% for product in products_to_show limit: marquee_count %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>

  {% if section.settings.show_view_all %}
    <div class="text-center mt-4">
      <a href="{{ section.settings.view_all_url | default: routes.collections_url }}" class="btn-hero-outline"
        style="color:{{ section.settings.accent_color }};border-color:{{ section.settings.accent_color }};">
        {{ section.settings.view_all_text }}
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "section-new-arrivals",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Freshly Formulated"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Clinical Arrivals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our latest breakthrough bio-active additions crafted for radiant skin health."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products in marquee",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f4f9f7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#152221"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#2F6B66"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}

