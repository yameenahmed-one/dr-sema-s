<section style="background:linear-gradient(135deg,rgba(15,26,25,0.96),rgba(33,79,75,0.92)),url('{{ section.settings.bg_image | img_url: "master" }}') center/cover no-repeat fixed;padding:100px 0;text-align:center;">
  <div class="container px-3 px-md-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <span class="section-tagline" style="color:var(--accent-mint);">{{ section.settings.tagline }}</span>
        <h2 style="font-family:var(--font-heading);font-size:clamp(2.2rem,4vw,3.6rem);color:#fff;margin-bottom:20px;">
          {{ section.settings.heading }}<br><em style="font-style:italic;color:var(--accent-mint);">{{ section.settings.heading_italic }}</em>
        </h2>
        <p style="color:rgba(255,255,255,0.72);max-width:520px;margin:0 auto 40px;font-size:1rem;line-height:1.7;">{{ section.settings.description }}</p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
          <a href="{{ routes.collections_url }}" class="btn-hero-primary px-5 py-3" style="font-size:1rem;">{{ section.settings.btn1_text }} <i class="bi bi-arrow-right ms-2"></i></a>
          <a href="/pages/contact" class="btn-hero-outline px-5 py-3" style="font-size:1rem;">{{ section.settings.btn2_text }} <i class="bi bi-chat-heart ms-2"></i></a>
        </div>
        <div class="d-flex flex-wrap justify-content-center gap-4 mt-5">
          {% for block in section.blocks %}
            <div class="d-flex align-items-center gap-2" style="color:rgba(255,255,255,0.65);font-size:0.82rem;">
              <i class="{{ block.settings.icon }}" style="color:var(--accent-mint);font-size:1.1rem;"></i> {{ block.settings.text }}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About CTA",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "START YOUR JOURNEY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Experience the Science" },
    { "type": "text", "id": "heading_italic", "label": "Heading Italic", "default": "of Radiant Skin" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Explore Karachi Cosmetology complete collection of clinical skincare formulations." },
    { "type": "text", "id": "btn1_text", "label": "Button 1", "default": "Shop Formulations" },
    { "type": "text", "id": "btn2_text", "label": "Button 2", "default": "Book Free Consult" }
  ],
  "blocks": [{
    "type": "badge", "name": "Trust Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "bi bi-patch-check-fill" },
      { "type": "text", "id": "text", "label": "Text", "default": "Dermatologist Certified" }
    ]
  }],
  "presets": [{ "name": "About CTA", "blocks": [
    { "type": "badge", "settings": { "icon": "bi bi-patch-check-fill", "text": "Dermatologist Certified" }},
    { "type": "badge", "settings": { "icon": "bi bi-heart-fill", "text": "Cruelty Free" }},
    { "type": "badge", "settings": { "icon": "bi bi-flower2", "text": "Organic Actives" }},
    { "type": "badge", "settings": { "icon": "bi bi-shield-check", "text": "Clinically Tested" }}
  ]}]
}
{% endschema %}

