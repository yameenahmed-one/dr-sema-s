<section style="background:#fff;padding:90px 0;">
  <div class="container px-3 px-md-5">
    <div class="section-header-center reveal-on-scroll mb-5">
      <span class="section-tagline">{{ section.settings.tagline }}</span>
      <h2 class="section-main-title">{{ section.settings.heading }}</h2>
      <p class="section-description">{{ section.settings.description }}</p>
    </div>
    <div class="row g-4">
      {% for block in section.blocks %}
        <div class="col-lg-3 col-md-6 reveal-on-scroll">
          <div style="background:var(--bg-cream);border:1px solid var(--border-light);border-radius:20px;padding:32px 24px;height:100%;box-shadow:var(--shadow-soft);transition:all 0.35s;text-align:center;position:relative;overflow:hidden;">
            <div style="width:66px;height:66px;border-radius:50%;background:#fff;color:var(--primary-sage);display:flex;align-items:center;justify-content:center;font-size:1.7rem;margin:0 auto 20px;box-shadow:0 6px 20px rgba(47,107,102,0.1);border:2px solid var(--accent-mint);">
              <i class="{{ block.settings.icon }}"></i>
            </div>
            <h4 style="font-family:var(--font-heading);font-size:1.3rem;font-weight:600;color:var(--text-dark);margin-bottom:10px;">{{ block.settings.title }}</h4>
            <p style="font-size:0.85rem;color:var(--text-muted);line-height:1.6;margin:0;">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Values",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "WHAT WE STAND FOR" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Brand Values" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Non-negotiable commitments that guide every ingredient choice and every formulation." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Bootstrap Icon Class", "default": "bi bi-droplet-fill" },
        { "type": "text", "id": "title", "label": "Title", "default": "Clean Beauty" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "1,400+ restricted ingredients. Zero parabens, sulfates, phthalates." }
      ]
    }
  ],
  "presets": [{ "name": "Brand Values", "blocks": [
    { "type": "value", "settings": { "icon": "bi bi-droplet-fill", "title": "Clean Beauty", "text": "1,400+ restricted ingredients. Zero parabens, sulfates, phthalates or synthetic colourants." } },
    { "type": "value", "settings": { "icon": "bi bi-heart-fill", "title": "Cruelty Free", "text": "100% cruelty-free. Never tested on animals. Leaping Bunny certified." } },
    { "type": "value", "settings": { "icon": "bi bi-flower2", "title": "Organic Ingredients", "text": "Botanicals sourced exclusively from USDA organic certified farms." } },
    { "type": "value", "settings": { "icon": "bi bi-clipboard2-pulse", "title": "Clinically Tested", "text": "Every product backed by independent double-blind clinical trials." } },
    { "type": "value", "settings": { "icon": "bi bi-recycle", "title": "Sustainable Packaging", "text": "Recyclable Italian glass vessels and FSC-certified paper." } },
    { "type": "value", "settings": { "icon": "bi bi-globe2", "title": "Inclusive for All", "text": "Formulated for all Fitzpatrick skin types, all ages and all genders." } },
    { "type": "value", "settings": { "icon": "bi bi-transparency", "title": "Full Transparency", "text": "Complete ingredient lists and clinical trial data published openly." } },
    { "type": "value", "settings": { "icon": "bi bi-award-fill", "title": "Award-Winning Quality", "text": "12 international beauty and dermatology awards worldwide." } }
  ]}]
}
{% endschema %}

